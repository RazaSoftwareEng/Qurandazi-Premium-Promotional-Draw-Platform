# ---------------------------------------------------------------
# QURANDAZI — environment variables (copy to .env.local)
# ---------------------------------------------------------------
# Only PUBLIC values belong here. Everything prefixed with VITE_
# is bundled into the browser build.
#
# NEVER put the Supabase service-role key in this file or in any
# VITE_ variable. The service-role key lives only in Supabase
# Edge Function secrets (it is injected automatically there).
# ---------------------------------------------------------------

# Supabase project URL  (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (sb_publishable_...)  (Project Settings -> API Keys)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy alternative (older projects): VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL of the deployed site. Used for auth email redirects
# (email verification, password reset). No trailing slash.
VITE_SITE_URL=http://localhost:5173
